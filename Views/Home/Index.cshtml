@using LaptopStore.Models
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-banner hero-banner-with-art text-white mb-4">
    <div class="hero-decor hero-decor-1"></div>
    <div class="hero-decor hero-decor-2"></div>

    <div class="container-fluid px-4 px-lg-5">
        <div class="row align-items-center">
            <div class="col-lg-7 py-5">
                <span class="section-eyebrow" style="color:#bfdbfe;">Cửa hàng laptop chính hãng</span>
                <h1 class="display-5 fw-bold mb-3">LaptopStore</h1>
                <p class="fs-5 mb-4" style="max-width: 560px; opacity:0.92;">
                    Đa dạng laptop văn phòng, gaming, đồ họa và mỏng nhẹ — giá tốt, chính hãng, giao hàng nhanh toàn quốc.
                </p>
                <a asp-controller="Laptop" asp-action="Index" class="btn btn-light btn-lg fw-bold btn-cta">
                    Xem tất cả sản phẩm <span aria-hidden="true">→</span>
                </a>
            </div>
            <div class="col-lg-5 d-none d-lg-block position-relative" style="height: 320px;">
                <img src="~/images/hero-bg-art.jpg" alt="Laptop Gaming" class="hero-art-img" />
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 px-lg-5 mb-5">
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <a href="#" class="promo-banner-link">
                <img src="~/images/promo-sale-soc.jpg" alt="Sale sốc laptop Gaming" class="promo-banner-img" />
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="#" class="promo-banner-link">
                <img src="~/images/promo-hang-moi-1.jpg" alt="Hàng mới về" class="promo-banner-img" />
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="#" class="promo-banner-link">
                <img src="~/images/promo-uu-dai-sv.jpg" alt="Ưu đãi sinh viên" class="promo-banner-img" />
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="#" class="promo-banner-link">
                <img src="~/images/promo-hang-moi-2.jpg" alt="Laptop Gaming sẵn hàng" class="promo-banner-img" />
            </a>
        </div>
    </div>
</div>

<div class="section-band">
    <div class="container-fluid px-4 px-lg-5">
        <span class="section-eyebrow">Khám phá theo nhu cầu</span>
        <h3 class="section-heading mb-4">Danh mục nổi bật</h3>

        <div class="row row-cols-2 row-cols-md-4 g-3">
            @{
                var catColors = new Dictionary<string, string> {
                    { "Laptop Gaming", "#7c3aed" },
                    { "Laptop Văn phòng", "#0891b2" },
                    { "Laptop Đồ họa - Kỹ thuật", "#ea580c" },
                    { "Laptop Mỏng nhẹ", "#16a34a" }
                };
            }
            @foreach (var cat in (List<Category>)ViewBag.Categories)
            {
                var color = catColors.ContainsKey(cat.Name) ? catColors[cat.Name] : "#2563eb";
                <div class="col">
                    <a asp-controller="Laptop" asp-action="Index" asp-route-categoryId="@cat.Id"
                       class="card category-card hover-lift h-100 text-decoration-none text-dark shadow-sm text-center py-4 d-flex align-items-center justify-content-center"
                       style="border-top-color: @color;">
                        <div class="fw-semibold">@cat.Name</div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container-fluid px-4 px-lg-5">

    <span class="section-eyebrow d-block mt-5">Được quan tâm nhiều nhất</span>
    <h3 class="section-heading mb-4">Sản phẩm nổi bật</h3>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
        @foreach (var item in (List<Laptop>)ViewBag.FeaturedLaptops)
        {
            <div class="col">
                <div class="card hover-lift h-100 shadow-sm">
                    <img src="@item.ImageUrl"
                         onerror="this.onerror=null;this.src='/images/no-image.png';"
                         class="card-img-top"
                         style="height:180px; object-fit:contain; padding:10px; background:#f8f9fa;"
                         alt="@item.Name">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2" style="width:fit-content;">@item.Brand</span>
                        <h6 class="card-title">@item.Name</h6>
                        <p class="fw-bold text-danger mt-auto mb-2">@item.Price.ToString("N0") VNĐ</p>
                        <a asp-controller="Laptop" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row text-center mb-5">
        <div class="col-md-4 mb-3">
            <div class="perk-icon">🛡️</div>
            <h6 class="fw-bold">Bảo hành chính hãng</h6>
            <p class="text-muted small mb-0">12–24 tháng tùy sản phẩm</p>
        </div>
        <div class="col-md-4 mb-3">
            <div class="perk-icon">🚚</div>
            <h6 class="fw-bold">Giao hàng nhanh</h6>
            <p class="text-muted small mb-0">Toàn quốc, hỗ trợ giao hỏa tốc</p>
        </div>
        <div class="col-md-4 mb-3">
            <div class="perk-icon">↩️</div>
            <h6 class="fw-bold">Đổi trả dễ dàng</h6>
            <p class="text-muted small mb-0">Trong vòng 7 ngày kể từ khi nhận hàng</p>
        </div>
    </div>

</div>
