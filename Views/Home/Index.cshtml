@using LaptopStore.Models
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #1e3a8a, #2563eb);">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold">LaptopStore</h1>
        <p class="fs-5 mb-3">Đa dạng laptop văn phòng, gaming, đồ họa và mỏng nhẹ — giá tốt, chính hãng, giao hàng nhanh toàn quốc.</p>
        <a asp-controller="Laptop" asp-action="Index" class="btn btn-light btn-lg fw-bold">Xem tất cả sản phẩm</a>
    </div>
</div>

<div class="container">

    <h3 class="mb-3">Danh mục nổi bật</h3>
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
        @foreach (var cat in (List<Category>)ViewBag.Categories)
        {
            <div class="col">
                <a asp-controller="Laptop" asp-action="Index" asp-route-categoryId="@cat.Id"
                   class="card h-100 text-decoration-none text-dark shadow-sm text-center py-4 d-flex align-items-center justify-content-center">
                    <div class="fw-semibold fs-5">@cat.Name</div>
                </a>
            </div>
        }
    </div>

    <h3 class="mb-3">Sản phẩm nổi bật</h3>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
        @foreach (var item in (List<Laptop>)ViewBag.FeaturedLaptops)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl"
                         onerror="this.onerror=null;this.src='/images/no-image.png';"
                         class="card-img-top"
                         style="height:180px; object-fit:contain; padding:10px; background:#f8f9fa;"
                         alt="@item.Name">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2" style="width:fit-content;">@item.Brand</span>
                        <h6 class="card-title">@item.Name</h6>
                        <p class="fw-bold text-danger mt-auto mb-2">@item.Price.ToString("N0") VNĐ</p>
                        <a asp-controller="Laptop" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row text-center mb-5">
        <div class="col-md-4 mb-3">
            <div style="font-size: 2rem;">🛡️</div>
            <h5>Bảo hành chính hãng</h5>
            <p class="text-muted">12–24 tháng tùy sản phẩm</p>
        </div>
        <div class="col-md-4 mb-3">
            <div style="font-size: 2rem;">🚚</div>
            <h5>Giao hàng nhanh</h5>
            <p class="text-muted">Toàn quốc, hỗ trợ giao hỏa tốc</p>
        </div>
        <div class="col-md-4 mb-3">
            <div style="font-size: 2rem;">↩️</div>
            <h5>Đổi trả dễ dàng</h5>
            <p class="text-muted">Trong vòng 7 ngày kể từ khi nhận hàng</p>
        </div>
    </div>

</div>
