@model LaptopStore.Models.Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
    var statuses = Enum.GetValues(typeof(LaptopStore.Models.OrderStatus)).Cast<LaptopStore.Models.OrderStatus>();
}

<div class="container-fluid px-4 px-lg-5 py-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Quay lại danh sách</a>

    <h2 class="mb-4">Chi tiết đơn hàng #@Model.Id</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
            <p><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
            <p><strong>Hình thức thanh toán:</strong> @Model.PaymentMethod</p>
        </div>
        <div class="col-md-6">
            <p><strong>Trạng thái hiện tại:</strong> <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToDisplayName()</span></p>
            <p><strong>Tổng tiền:</strong> <span class="fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") VNĐ</span></p>

            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 mt-3">
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="newStatus" class="form-select">
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s.ToDisplayName()</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary text-nowrap">Cập nhật</button>
            </form>
        </div>
    </div>

    <h5>Danh sách sản phẩm</h5>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.LaptopName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                    <td>@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
                </tr>
            }
        </tbody>
    </table>
</div>
