@model List<(LaptopStore.Models.ApplicationUser User, bool IsLocked, System.Collections.Generic.IList<string> Roles)>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="container-fluid px-4 px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Quản lý tài khoản</h2>
        <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Quản lý đơn hàng</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.User.FullName</td>
                        <td>@item.User.Email</td>
                        <td>@item.User.PhoneNumber</td>
                        <td>
                            @if (item.Roles.Any())
                            {
                                foreach (var role in item.Roles)
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Khách hàng</span>
                            }
                        </td>
                        <td>
                            @if (item.IsLocked)
                            {
                                <span class="badge bg-danger">Đã khoá</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                        </td>
                        <td>
                            @if (!item.Roles.Contains("Admin"))
                            {
                                <form asp-action="ToggleLock" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.User.Id" />
                                    @if (item.IsLocked)
                                    {
                                        <button type="submit" class="btn btn-sm btn-success">Mở khoá</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-danger">Khoá tài khoản</button>
                                    }
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Tài khoản quản trị</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
